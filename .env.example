# Comma-separated list of providers to enable: azure,aws,twilio,airship,cloudflare,github,imperva,microsoft_ppac,microsoft_mac
PROVIDERS=azure

# Comma-separated list of notifiers to enable: telegram
NOTIFIERS=telegram

# Global settings
POLL_INTERVAL_MINUTES=5
REQUEST_TIMEOUT_SECS=30
STATE_FILE_PATH=state.json

# Provider-specific settings
PROVIDER_AZURE_FEED_URL=https://rssfeed.azure.status.microsoft/en-us/status/feed/
PROVIDER_MICROSOFT_PPAC_FEED_URL=https://status.cloud.microsoft/api/feed/ppac
PROVIDER_MICROSOFT_MAC_FEED_URL=https://status.cloud.microsoft/api/feed/mac

# Notifier-specific settings
NOTIFIER_TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234gh...
NOTIFIER_TELEGRAM_CHAT_ID=-1001234567890

RUST_LOG=info
