# Comma-separated list of providers to enable: azure,microsoft,aws,twilio,airship,cloudflare,github,imperva
PROVIDERS=azure,microsoft

# Comma-separated list of notifiers to enable: telegram
NOTIFIERS=telegram

# Global settings
POLL_INTERVAL_MINUTES=5
REQUEST_TIMEOUT_SECS=30
STATE_FILE_PATH=state.json

# Provider-specific settings (override defaults; remove to use built-in URLs)
PROVIDER_AZURE_FEED_URL=https://azure.status.microsoft/en-us/status/feed/
PROVIDER_MICROSOFT_FEED_URL=https://status.microsoft.com/en-us/status/feed/

# Notifier-specific settings
NOTIFIER_TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234gh...
NOTIFIER_TELEGRAM_CHAT_ID=-1001234567890

RUST_LOG=info
